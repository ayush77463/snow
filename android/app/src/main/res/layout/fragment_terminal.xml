<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:padding="12dp">

    <!-- Terminal Status Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:text="@string/title_terminal_console" />

        <TextView
            android:id="@+id/tv_terminal_exit_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/status_connected"
            android:background="@drawable/bg_pill_status"
            android:text="IDLE" />
    </LinearLayout>

    <!-- Quick Command History Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_whoami"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="whoami"
                style="@style/Widget.Material3.Chip.Suggestion" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_dir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dir"
                style="@style/Widget.Material3.Chip.Suggestion" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_ipconfig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ipconfig"
                style="@style/Widget.Material3.Chip.Suggestion" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_systeminfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="systeminfo"
                style="@style/Widget.Material3.Chip.Suggestion" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_git_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="git status"
                style="@style/Widget.Material3.Chip.Suggestion" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Console Output Surface (Dark Monospace) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#0F172A"
        app:strokeColor="#1E293B"
        app:strokeWidth="1dp">

        <ScrollView
            android:id="@+id/sv_terminal_output"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_terminal_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#38BDF8"
                android:textIsSelectable="true"
                android:text="SNOW Desktop Terminal Bridge [Version 3.0]\nAuthenticated local-first channel active.\nType a command below or tap a quick chip to run.\n" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Command Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_terminal_cmd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Command (e.g. dir, whoami)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_terminal_cmd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_terminal_run"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btn_execute"
            style="@style/Widget.Material3.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_terminal_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:visibility="gone"
            android:text="@string/btn_cancel_command"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

</LinearLayout>
