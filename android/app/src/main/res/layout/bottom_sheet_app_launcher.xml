<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/card_surface">

    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:text="Launch Windows Application" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:textSize="13sp"
        android:textColor="@color/secondary_text"
        android:text="Select an allowlisted application to open on the paired Windows PC." />

    <ListView
        android:id="@+id/app_list_view"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:divider="@color/card_border"
        android:dividerHeight="1dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:text="Owner Custom Executable (OWNER_MANUAL)" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_custom_target"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:hint="e.g. code or C:\\App\\tool.exe"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_launch_custom"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Launch"
            android:textSize="13sp"
            android:backgroundTint="@color/primary_blue" />
    </LinearLayout>

</LinearLayout>
