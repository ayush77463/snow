<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top SAF Destination Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/card_surface"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:text="Download Destination (SAF)" />

                <TextView
                    android:id="@+id/tv_saf_destination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue"
                    android:text="Default: Downloads/SNOW" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_change_saf_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change"
                style="@style/Widget.Material3.Button.TonalButton" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons Row: Send File & Terminal Console -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_file_to_pc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Send File"
            android:textColor="@color/card_surface"
            android:backgroundTint="@color/primary_blue"
            app:icon="@drawable/ic_pc_file"
            app:iconTint="@color/card_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_terminal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Terminal"
            style="@style/Widget.Material3.Button.TonalButton"
            app:icon="@drawable/ic_nav_terminal" />
    </LinearLayout>

    <!-- Remote PC Explorer Main Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_surface"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Explorer Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btn_nav_up"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_pc_arrow_up"
                    app:tint="@color/primary_text"
                    android:contentDescription="Navigate Up" />

                <TextView
                    android:id="@+id/tv_current_path"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/primary_text"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text="C:\\" />

                <ImageView
                    android:id="@+id/btn_refresh_files"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_pc_refresh"
                    app:tint="@color/primary_text"
                    android:contentDescription="Refresh" />
            </LinearLayout>

            <!-- Quick Jump Drive Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_drives"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_c_drive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="C:\\"
                        style="@style/Widget.Material3.Chip.Assist" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_d_drive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="D:\\"
                        style="@style/Widget.Material3.Chip.Assist" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_desktop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Desktop"
                        style="@style/Widget.Material3.Chip.Assist" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_downloads"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Downloads"
                        style="@style/Widget.Material3.Chip.Assist" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_documents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Documents"
                        style="@style/Widget.Material3.Chip.Assist" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Hide Hidden Files Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:text="@string/switch_hide_hidden" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_hide_hidden"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Loading & Error States -->
            <ProgressBar
                android:id="@+id/pb_files_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_files_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/secondary_text"
                android:visibility="gone"
                android:text="This folder is empty or unreachable." />

            <!-- File List Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_pc_files"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
