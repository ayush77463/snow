<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using MaterialComponents Light NoActionBar (Glacier Blue) -->
    <style name="Theme.SNOW" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/tertiary_blue</item>
        <item name="colorSecondary">@color/secondary_cyan</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
    </style>
</resources>
