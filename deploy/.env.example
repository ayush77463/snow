# SNOW Remote MCP Platform & Hybrid Relay — Environment Configuration
# Copy this file to .env and adjust values before launching

# Public Fully Qualified Domain Name (FQDN) pointed to this host's public IP
SNOW_DOMAIN=mcp.example.com

# Email address used for automatic TLS certificates via Let's Encrypt / ZeroSSL
CADDY_ACME_EMAIL=admin@example.com

# Public HTTPS URL of the Remote MCP Gateway
SNOW_MCP_PUBLIC_URL=https://mcp.example.com

# Trusted proxy IPs or container names for safe X-Forwarded-For evaluation
SNOW_MCP_TRUSTED_PROXIES=caddy,127.0.0.1,::1

# Shared secret for self-hosted relay server authentication (safe placeholder)
SNOW_RELAY_SECRET=replace_with_strong_random_secret_in_production

# Optional: Dedicated SNOW data directory
SNOW_DATA_DIR=/home/snow/.snow
